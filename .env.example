# Copy to .env.local for local dev, and add the same vars in Vercel → Project → Settings → Environment Variables.

# Canonical site URL. Used for metadata, OG tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form ---------------------------------------------------------
# The form at /contact posts to /api/contact. That route needs ONE provider.
#
# Option A (default): Resend — https://resend.com  (free tier, 3k emails/mo)
#   1. Create an account and an API key
#   2. Verify your sending domain under Domains (or leave the test sender below)
#
# CONTACT_FROM_EMAIL is the "From:" address on the mail the form sends YOU.
# It must be at a domain verified in Resend. `onboarding@resend.dev` is
# Resend's shared test sender — no setup, but it only delivers to your own
# Resend account address. Reply-To is always set to whoever filled the form,
# so replying in your inbox reaches them directly.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=faiyajr@umich.edu

# Option B: Formspree — set this instead and the route forwards to it.
# Leave RESEND_API_KEY blank if you use this.
FORMSPREE_ENDPOINT=

# If neither is set, the form still validates and renders, but the route
# returns a clear "not configured" error instead of silently dropping mail.

# --- Spotify (the "on repeat" panel on /about) ----------------------------
# Optional. Without these the panel simply does not render.
#
#   1. Create an app at https://developer.spotify.com/dashboard
#   2. Add this Redirect URI:  http://127.0.0.1:8888/callback
#   3. Paste the client ID and secret below
#   4. Run `npm run spotify:auth` — it prints the refresh token to paste here
#
# Refresh tokens do not expire, so step 4 is a one-time thing.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Dev-only motion preview ---
# Set to 1 to play animations even when your OS has reduced motion enabled.
# Ignored in production builds regardless of value.
NEXT_PUBLIC_FORCE_MOTION=
